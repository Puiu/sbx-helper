# Sandbox secrets template — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and never committed. This file (.env.example) holds
# placeholders only — never put real keys here.
#
# After filling in .env, run:
#   ./setup-secrets.sh
# Then (re)create sandboxes so the new env vars are present inside
# (`sbx rm` + `sbx run`; secrets added later are not retroactive).

# Context7 docs lookup API key (https://context7.com).
# Works unset (anonymous tier, lower rate limits); set for your own plan.
# Injected at sandbox runtime for host mcp.context7.com.
CONTEXT7_API_KEY=

# Azure DevOps Personal Access Token (https://dev.azure.com → User settings → PATs).
# Injected at sandbox runtime for hosts dev.azure.com and pkgs.dev.azure.com.
# Used for git HTTPS auth / NuGet feeds / Azure CLI inside the sandbox.
AZURE_DEVOPS_PAT=

# OpenCode Zen API key (https://opencode.ai).
# Sandboxes do not see host ~/.config/opencode/, so the key is injected
# at runtime as OPENCODE_API_KEY for host opencode.ai (referenced by the
# managed /etc/opencode/opencode.json via {env:OPENCODE_API_KEY}).
OPENCODE_API_KEY=


# GitHub Personal Access Token (https://github.com → Settings → Developer settings → Personal access tokens).
# Stored twice by setup-secrets.sh: as the `github` service secret (what the sbx
# proxy uses to authenticate git-over-HTTPS and GitHub API traffic on the sandbox's
# behalf) and as the GITHUB_PAT env var for tools inside the sandbox that read it
# directly. Needs `repo` scope (classic) or Contents: Read/Write (fine-grained).
# Expiring the PAT silently breaks git in every sandbox — re-run setup-secrets.sh
# after rotating.
GITHUB_PAT=


# Claude Code OAuth token (https://www.anthropic.com/claude).
# Injected at sandbox runtime for host api.anthropic.com.
# CLAUDE_CODE_OAUTH_TOKEN=

# Jev decision-support API key (https://www.jevai.org/agent → API keys page).
# Injected at sandbox runtime for host www.jevai.org, referenced by the Claude
# images' `claude mcp add ... --header 'Authorization: Bearer ${JEV_API_KEY}'`
# (claude/dotnet/Dockerfile, claude/dotnet-swift/Dockerfile). Without it the
# jev MCP server (six jev_* tools) fails to authenticate.
JEV_API_KEY=
