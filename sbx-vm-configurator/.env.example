# Sandbox secrets template — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and never committed. This file (.env.example) holds
# placeholders only — never put real keys here.
#
# After filling in .env, run:
#   ./setup-secrets.sh
# Then (re)create sandboxes so the new env vars are present inside
# (`sbx rm` + `sbx run`; secrets added later are not retroactive).

# Context7 docs lookup API key (https://context7.com).
# Works unset (anonymous tier, lower rate limits); set for your own plan.
# Injected at sandbox runtime for host mcp.context7.com.
CONTEXT7_API_KEY=

# Azure DevOps Personal Access Token (https://dev.azure.com → User settings → PATs).
# Injected at sandbox runtime for host dev.azure.com.
# Used for git HTTPS auth / NuGet feeds / Azure CLI inside the sandbox.
AZURE_DEVOPS_PAT=

# OpenCode Zen API key (https://opencode.ai).
# Sandboxes do not see host ~/.config/opencode/, so the key is injected
# at runtime as OPENCODE_API_KEY for host opencode.ai (referenced by the
# managed /etc/opencode/opencode.json via {env:OPENCODE_API_KEY}).
OPENCODE_API_KEY=
