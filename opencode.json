{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["src/electron/CLAUDE.md"],
  "lsp": {
    "sourcekit-lsp": {
      "command": ["xcrun", "sourcekit-lsp"],
      "extensions": [".swift"]
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.build/**",
      "**/.swiftpm/**",
      "**/*.app/**",
      "src/electron/out/**"
    ]
  },
  "permission": {
    "edit": {
      "*": "allow",
      "src/electron/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny"
    }
  }
}
